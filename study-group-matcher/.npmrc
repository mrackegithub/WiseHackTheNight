# Each package keeps its OWN pnpm-lock.yaml so agents adding deps never conflict
# on a shared root lockfile. Do not change without a human decision (docs/decisions/0002).
shared-workspace-lockfile=false
link-workspace-packages=true
# Keep node_modules/.pnpm folder names short. Node's ESM resolver cannot read package.json
# files past Windows' 260-char MAX_PATH, which breaks Vite/Vitest on deep checkout paths.
virtual-store-dir-max-length=40
