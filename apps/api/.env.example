PORT=4000
# Interface the API binds to (use 0.0.0.0 to reach it from other devices on the LAN)
HOST=localhost
DATABASE_URL=postgresql://sgm:sgm@localhost:5432/sgm
JWT_SECRET=change-me
ICS_ENCRYPTION_KEY=32-byte-hex-change-me
GEOCODER_URL=https://nominatim.openstreetmap.org
# Nominatim blocks generic or placeholder agents (403); leave empty for the app's default
GEOCODER_USER_AGENT=
BOOKING_PROVIDER=MOCK
CORS_ORIGIN=http://localhost:5173
