{
  "name": "@sgm/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "test": "vitest run",
    "test:contract": "vitest run test/contract",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed/index.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@fastify/autoload": "^6.5.1",
    "@prisma/client": "^6.19.3",
    "@sgm/contracts": "workspace:*",
    "@sgm/integrations": "workspace:*",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
