// OWNER: human (Phase 0). Generator + datasource only.
// Multi-file schema: every *.prisma file in this folder is merged by Prisma (>= 6.7).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
